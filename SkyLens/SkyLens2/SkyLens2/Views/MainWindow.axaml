<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SkyLens2.Views.MainWindow"
        Title="StellarScope"
        Width="1400" Height="900"
        Background="#F4F7F6"
        FontFamily="Arial">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#CCCCCC" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Image Source="avares://SkyLens2/Assets/SkyLensLogo.png" Width="100" Grid.Column="0" Margin="0 0 10 0"/>
                <TextBlock Text="Emmen, Netherlands" Grid.Column="1" FontSize="18" Foreground="Black"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="DateTimeText" Grid.Column="2" FontSize="18" Foreground="Black"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ContentControl x:Name="MainContent" Grid.Row="1">
            <ScrollViewer>
                <StackPanel HorizontalAlignment="Center" MaxWidth="1400" Spacing="30" Margin="20">
                    
                    <!-- Observation Section -->
                    <Border Background="White"
                            CornerRadius="30"
                            Padding="20"
                            Width="1000"
                            HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <!-- Left Column -->
                            <StackPanel Margin="20 0 30 0" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="Explore the universe"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="Black"/>

                                <TextBlock Text="Today's observation conditions:"
                                           Foreground="Black"/>
                                <TextBlock Text="Outlook: Favourable"
                                           FontWeight="Bold"
                                           Foreground="Black"/>
                                <TextBlock Text="Recommended Observation Time: 23:45–03:37"
                                           FontWeight="Bold"
                                           Foreground="Black"/>

                                <!-- Move buttons down a bit -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Spacing="20"
                                            Margin="0 70 20 10">
                                    <Button Classes="PrimaryButton"
                                            Content="Explore the Sky"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"/>
                                    <Button Classes="PrimaryButton"
                                            Content="See Star Chart"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Right Column (Moon) -->
                            <Border Background="#DDDDDD"
                                    CornerRadius="20"
                                    Padding="20"
                                    Width="300"
                                    Grid.Column="1">
                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                    <Image Source="avares://SkyLens2/Assets/moonimg.png" Width="200"/>
                                    <TextBlock Text="Current Moon Phase"
                                               HorizontalAlignment="Center"
                                               Foreground="Black"/>
                                    <TextBlock Text="100%"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="Black"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Weather Section -->
                    <Border Background="White" CornerRadius="30" Padding="20">
                        <StackPanel Spacing="20">
                            <TextBlock Foreground="Black" Text="Weather" FontSize="30" FontWeight="Bold" Margin="0 0 0 30" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="50">
                                <!-- Cloud Cover -->
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Image Source="avares://SkyLens2/Assets/CloudCoverIcon.png" Width="100" Height="100"/>
                                    <TextBlock Foreground="Black" Text="Cloud Cover: Clear (11%)" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Light Pollution -->
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Image Source="avares://SkyLens2/Assets/LightPollutionIcon.png" Width="100" Height="100"/>
                                    <TextBlock Foreground="Black" Text="Light Pollution: Medium (33%)" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Air Turbulence -->
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Image Source="avares://SkyLens2/Assets/AirTurbulenceIcon.png" Width="100" Height="100"/>
                                    <TextBlock Foreground="Black" Text="Air Turbulence: Stable (1)" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Explore Section -->
                    <Border Background="White" CornerRadius="30" Padding="20">
                        <StackPanel Spacing="20">
                            <TextBlock Foreground="Black" Text="Explore" FontSize="30" FontWeight="Bold" Margin="0 0 0 30" HorizontalAlignment="Center"/>
                            <StackPanel Spacing="15" HorizontalAlignment="Center">
                                <Button Classes="LargeButton" Content="Constellations" Click="OnNavigateConstellations"/>
                                <Button Classes="LargeButton" Content="Planets" Click="OnNavigatePlanets"/>
                                <Button Classes="LargeButton" Content="Stars" Click="OnNavigateStars"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ContentControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="10">
            <TextBlock Text="© 2025 SkyLens" Foreground="#999999" HorizontalAlignment="Center" FontSize="12"/>
        </Border>
    </Grid>
</Window>