<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SkyLens2.ViewModels"
        x:Class="SkyLens2.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="SkyLens"
        Width="1400" Height="900"
        Background="#1230AE"
        FontFamily="Arial">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#FFE1FF" Padding="15" BorderBrush="#CCCCCC" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Image Source="avares://SkyLens2/Assets/SkyLensLogo.png"
                       Width="100"
                       Grid.Column="0"
                       Margin="0 0 10 0"
                       VerticalAlignment="Center"/>

                <!-- Center: Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <Button Content="Home" Click="OnNavigateHome" Classes="HeaderButton"/>
                    <Button Content="Weather" Click="OnNavigateWeather" Classes="HeaderButton"/>
                    <Button Content="Constellations" Click="OnNavigateConstellations" Classes="HeaderButton"/>
                    <Button Content="Stars" Click="OnNavigateStars" Classes="HeaderButton"/>
                </StackPanel>

                <!-- Right: Location and Time -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Emmen, Netherlands" FontSize="16" Foreground="Black" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DateTimeText" FontSize="16" Foreground="Black" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <ContentControl x:Name="MainContent"
                            HorizontalAlignment="Center"
                            Margin="20"
                            MaxWidth="1400"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFE1FF" Padding="10">
            <TextBlock Text="© 2025 SkyLens" Foreground="#999999" HorizontalAlignment="Center" FontSize="12"/>
        </Border>
    </Grid>
</Window>