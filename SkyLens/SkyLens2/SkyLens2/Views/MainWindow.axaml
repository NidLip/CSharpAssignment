<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SkyLens2.ViewModels"
        x:Class="SkyLens2.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="SkyLens2"
        Width="800" Height="450">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{Binding StatusMessage}" FontSize="16" Foreground="Red"/>
        <TextBlock Text="{Binding CurrentData.Temperature, StringFormat='Temperature: {0} °C'}" />
        <TextBlock Text="{Binding CurrentData.CloudCoverage, StringFormat='Cloud Coverage: {0}%'}" />
        <TextBlock Text="{Binding CurrentData.WindSpeed, StringFormat='Wind Speed: {0} m/s'}" />
        <TextBlock Text="{Binding CurrentData.MoonPhase, StringFormat='Moon Phase: {0}'}" />
        <TextBlock Text="{Binding CurrentData.Sunrise, StringFormat='Sunrise: {0:HH:mm}'}" />
        <TextBlock Text="{Binding CurrentData.Sunset, StringFormat='Sunset: {0:HH:mm}'}" />
        <TextBlock Text="{Binding CurrentData.SunAltitude, StringFormat='Sun Altitude: {0}°'}" />
        <TextBlock Text="{Binding CurrentData.SunAzimuth, StringFormat='Sun Azimuth: {0}°'}" />
        <TextBlock Text="{Binding CurrentData.StageOfNight, StringFormat='Stage of Night: {0}'}" />
        <TextBlock Text="{Binding CurrentData.LocationName}" FontSize="20" FontWeight="Bold" Foreground="White"/>
    </StackPanel>
</Window>