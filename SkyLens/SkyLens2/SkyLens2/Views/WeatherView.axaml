<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SkyLens2.ViewModels"
        x:Class="SkyLens2.Views.WeatherView"
        x:DataType="viewModels:WeatherViewModel">

    <StackPanel VerticalAlignment="Top">
        <!-- Heading Section -->
        <TextBlock Text="Weather Conditions" FontSize="24" HorizontalAlignment="Center" Margin="0 20 0 20"/>

        <!-- First Section: Current Weather -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <TextBlock Text="{Binding CurrentDate}" FontSize="20"/>
            <TextBlock Text="{Binding CloudCoverageText}" FontSize="16"/>
            <TextBlock Text="{Binding WindSpeed}" FontSize="16"/>
        </StackPanel>

        <!-- Second Section: Next Day -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <TextBlock Text="{Binding NextDate1}" FontSize="20"/>
        </StackPanel>

        <!-- Third Section: Day After Next -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <TextBlock Text="{Binding NextDate2}" FontSize="20"/>
        </StackPanel>
    </StackPanel>

</UserControl>