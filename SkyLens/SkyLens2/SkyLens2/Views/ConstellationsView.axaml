<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="https://github.com/avaloniaui"
             xmlns:vm="clr-namespace:SkyLens2.ViewModels"
             x:Class="SkyLens2.Views.ConstellationsView"
             x:DataType="vm:ConstellationsViewModel">
    
    <Grid RowDefinitions="Auto, *" Margin="16">
        <TextBlock Text="Visible Constellations" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <DataGrid ItemsSource="{Binding Constellations}" AutoGenerateColumns="False" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Azimuth" Binding="{Binding Azimuth}" />
                <DataGridTextColumn Header="Altitude" Binding="{Binding Altitude}" />
                <DataGridTextColumn Header="Notable Stars" Binding="{Binding NotableStars}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>