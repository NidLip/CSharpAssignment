<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="https://github.com/avaloniaui"
             xmlns:vm="clr-namespace:SkyLens2.ViewModels"
             x:Class="SkyLens2.Views.ConstellationsView"
             x:DataType="vm:ConstellationsViewModel">
    
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="Visible Constellations" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Constellations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                    <WrapPanel>
                                        <TextBlock Text="Azimuth: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Azimuth}"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Altitude: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Altitude}"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Notable Stars: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding NotableStars}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>
    </ScrollViewer>

</UserControl>