<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="https://github.com/avaloniaui"
             xmlns:vm="clr-namespace:SkyLens2.ViewModels"
             x:Class="SkyLens2.Views.ConstellationsView"
             x:DataType="vm:ConstellationsViewModel">
    
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20, 20" Spacing="16" HorizontalAlignment="Stretch" MaxWidth="1000">
            <TextBlock Text="Visible Constellations" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <ItemsControl ItemsSource="{Binding Constellations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray"
                                Background="#6C48C5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,20"
                                Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                                <WrapPanel>
                                    <TextBlock Text="Azimuth: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Azimuth}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="Altitude: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Altitude}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="Notable Stars: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding NotableStars}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>


</UserControl>